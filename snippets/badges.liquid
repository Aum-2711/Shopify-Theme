<link rel="stylesheet" href="{{ 'badge-styling.css' | asset_url }}">

{% if product_card %}
    {%- for position in positions -%}
        {% if position == 'product info top' or position == 'after price' %}
            {% assign wrraper_class = "badge-wrapper" %}
        {% else %}
            {% assign wrraper_class = "card__badge " | append: position %}
        {% endif %}
        <div class="{{ wrraper_class }}">
        {% if product.metafields.custom.badges != blank %}
            {% for badge in product.metafields.custom.badges.value %}
                {%- assign class_position = badge.product_card.value.position | downcase -%}
                {%- assign class_animation = badge.animation.value.animation | downcase -%}
                {%- if position == class_position -%}
                    {% if badge.type.value == true %}
                        <span class="badge custom-badge {{ class_animation }}" style="color:{{ badge.text_colour.value }}; background:{{ badge.background_colour.value }}; border-radius:{{ badge.border_radius.value }}px; display: inline-block;">
                        {{ badge.text }}
                        </span>
                    {% else  %}
                        <img src="{{ badge.image.value | img_url: 'master' }}" width="{{ badge.width }}" height="{{ badge.height }}" class="badge-image {{ class_animation }}">
                    {% endif %}
                {%- endif -%}
            {% endfor %}
        {% endif %}
        {% if position == settings.badge_position %}
            {%- if product.available == false -%}
                {% if settings.sold_out_badge_show == "enable" %}
                    <span id="NoMediaStandardBadge-{{ section_id }}-{{ product.id }}" class="badge badge--bottom-left color-{{ settings.sold_out_badge_color_scheme }} {{ settings.sold_out_animations }}">
                        {{- 'products.product.sold_out' | t -}}
                    </span>
                {% endif %}
            {%- elsif product.compare_at_price > product.price and product.available -%}
                {% if settings.sale_badge_show == "enable" %}
                    <span id="NoMediaStandardBadge-{{ section_id }}-{{ product.id }}" class="badge badge--bottom-left color-{{ settings.sale_badge_color_scheme }} {{ settings.sale_animations }}">
                        {% if settings.badge_type == "percentage" %}
                            {%- assign difference = product.selected_or_first_available_variant.compare_at_price | minus: product.selected_or_first_available_variant.price -%}
                            {%- assign float_difference = difference | times: 1.0 -%}
                            {%- assign discount_fraction = float_difference | divided_by: product.selected_or_first_available_variant.compare_at_price -%}
                            {%- assign discount_percentage = discount_fraction | times: 100 | round -%}

                            {% if settings.percentage_start <= discount_percentage %}
                                {{- discount_percentage }}% OFF
                            {% else %}
                                {{- 'products.product.on_sale' | t -}}
                            {% endif %}
                        {%  else %}
                            {{- 'products.product.on_sale' | t -}}
                        {% endif %}
                    </span>
                {% endif %}
            {%- endif -%}
        {% endif %}

        {% if settings.new_badge_enable == "enable"%}
            {% if position == settings.new_badge_position %}
                {% assign current_date = 'now' | date: '%s' %}
                {% assign product_date = product.published_at | date: '%s' %}
                {% assign days_since_publish = current_date | minus: product_date | divided_by: 86400 %}
                {% if days_since_publish <= settings.new_badge_end %}
                    {% if settings.new_badge_option == 'text' %}
                        <span class="badge custom-badge badge color-{{ settings.new_badge_color_scheme }} {{ settings.new_animations }}" style="display: inline-block;">
                            {{ settings.new_badge_text }}
                        </span>
                    {% elsif settings.new_badge_option == 'image' %}
                        <img src="{{ settings.new_badge_image | img_url: 'master' }}" width="{{ settings.new_badge_image_width }}" height="auto" class="{{ settings.new_animations }}">
                    {% endif %}
                {% endif %}
            {% endif %}
        {% endif %}
        </div>
    {%- endfor -%}
{% elsif product_media %}
    {% if thumbnail %}
        {% assign wrraper_class = "product__badge-container badge--hidden" %}
    {% else %}
        {% assign wrraper_class = "product__badge-container" %}
    {% endif %}
    <div class="{{ wrraper_class }}">
        {%- for position in positions -%}
            <div class="product__badge {{ position }}">
                <div class="product__badge-wrapper">
                    {% if product.metafields.custom.badges != blank %}
                        {% for badge in product.metafields.custom.badges.value %}
                            {%- assign class_position = badge.product_page.value.position | downcase -%}
                            {%- assign class_animation = badge.animation.value.animation | downcase -%}
                            {%- if position == class_position -%}
                                {% if badge.type.value == true %}
                                    <span class="badge custom-badge {{ class_animation }}" style="color:{{ badge.text_colour.value }}; background:{{ badge.background_colour.value }}; border-radius:{{ badge.border_radius.value }}px; display: inline-block;">
                                    {{ badge.text }}
                                    </span>
                                {% else  %}
                                    <img src="{{ badge.image.value | img_url: 'master' }}" width="{{ badge.width }}" height="{{ badge.height }}" class="badge-image {{ class_animation }}">
                                {% endif %}
                            {%- endif -%}
                        {% endfor %}
                    {% endif %}

                    {% if position == settings.badge_position %}
                        {%- if product.available == false -%}
                            {% if settings.sold_out_badge_show == "enable" %}
                                <span id="NoMediaStandardBadge-{{ section_id }}-{{ product.id }}" class="badge badge--bottom-left color-{{ settings.sold_out_badge_color_scheme }} {{ settings.sold_out_animations }}">
                                    {{- 'products.product.sold_out' | t -}}
                                </span>
                            {% endif %}
                        {%- elsif product.compare_at_price > product.price and product.available -%}
                            {% if settings.sale_badge_show == "enable" %}
                                <span id="NoMediaStandardBadge-{{ section_id }}-{{ product.id }}" class="badge badge--bottom-left color-{{ settings.sale_badge_color_scheme }} {{ settings.sale_animations }}">
                                    {% if settings.badge_type == "percentage" %}
                                        {%- assign difference = product.selected_or_first_available_variant.compare_at_price | minus: product.selected_or_first_available_variant.price -%}
                                        {%- assign float_difference = difference | times: 1.0 -%}
                                        {%- assign discount_fraction = float_difference | divided_by: product.selected_or_first_available_variant.compare_at_price -%}
                                        {%- assign discount_percentage = discount_fraction | times: 100 | round -%}

                                        {% if settings.percentage_start <= discount_percentage %}
                                            {{- discount_percentage }}% OFF
                                        {% else %}
                                            {{- 'products.product.on_sale' | t -}}
                                        {% endif %}
                                    {%  else %}
                                        {{- 'products.product.on_sale' | t -}}
                                    {% endif %}
                                </span>
                            {% endif %}
                        {%- endif -%}
                    {% endif %}

                    {% if settings.new_badge_enable == "enable"%}
                        {% if position == settings.new_badge_position %}
                            {% assign current_date = 'now' | date: '%s' %}
                            {% assign product_date = product.published_at | date: '%s' %}
                            {% assign days_since_publish = current_date | minus: product_date | divided_by: 86400 %}
                            {% if days_since_publish <= settings.new_badge_end %}
                                {% if settings.new_badge_option == 'text' %}
                                    <span class="badge custom-badge badge color-{{ settings.new_badge_color_scheme }} {{ settings.new_animations }}" style="display: inline-block;">
                                        {{ settings.new_badge_text }}
                                    </span>
                                {% elsif settings.new_badge_option == 'image' %}
                                    <img src="{{ settings.new_badge_image | img_url: 'master' }}" width="{{ settings.new_badge_image_width }}" height="auto" class="{{ settings.new_animations }}">
                                {% endif %}
                            {% endif %}
                        {% endif %}
                    {% endif %}
                </div>
            </div>
        {%- endfor -%}
    </div>
