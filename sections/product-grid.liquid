{% comment %}
  Product Grid Section - Shows all available products
{% endcomment %}
<section class="product-grid-section page-width page-wrapper">
  <div class="section-header">
    <h2>{{ section.settings.heading }}</h2>
  </div>

  <div class="product-grid">
    {% paginate collections.all.products by 6 %}
      {% for product in collections.all.products %}
        <div class="product-card">
          <a href="{{ product.url }}" class="product-card__image">
            {% if product.featured_image %}
              <img 
                src="{{ product.featured_image | img_url: '400x' }}" 
                alt="{{ product.featured_image.alt | escape }}" 
                height="200" 
                width="200"
                loading="lazy"
                decoding="async"
              >
            {% else %}
              <div class="no-image">No image</div>
            {% endif %}
          </a>

          <div class="product-card__info">
            <h3 class="product-card__title">
              <a href="{{ product.url }}">{{ product.title }}</a>
            </h3>
            <p class="product-card__price">
              {{ product.price | money }}
            </p>

            <button 
            class="product-card__add-btn add-to-cart-btn" 
            data-variant-id="{{ product.first_available_variant.id }}"
            {% unless product.available %}disabled{% endunless %}
            >
                {% if product.available %}
                    Add to cart
                {% else %}
                    Sold out
                {% endif %}
            </button>
          </div>
        </div>
      {% endfor %}

      <div class="pagination">
        {{ paginate | default_pagination }}
      </div>
    {% endpaginate %}
  </div>
</section>

{% schema %}
{
  "name": "Product Grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "All Products"
    }
  ],
  "presets": [
    {
      "name": "Product Grid"
    }
  ]
}
{% endschema %}

{% stylesheet %}
.product-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  gap: 20px;
}
.product-card {
  border: 1px solid #eee;
  padding: 15px;
  text-align: center;
  border-radius: 8px;
}
.product-card__image img {
  max-width: 100%;
  border-radius: 6px;
}
.product-card__title {
  font-size: 16px;
  margin: 10px 0 5px;
}
.product-card__price {
  font-weight: bold;
  margin-bottom: 10px;
}
.product-card__add-btn {
  background: #000;
  color: #fff;
  padding: 10px 15px;
  border: none;
  border-radius: 4px;
  cursor: pointer;
}
.product-card__add-btn:disabled {
  background: #ccc;
  cursor: not-allowed;
}
{% endstylesheet %}
