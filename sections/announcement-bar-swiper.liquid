{% comment %}
--------------------------------------------------------------------------------
Announcement Bar – Native Fade Slider (Theme Class Integrated)
--------------------------------------------------------------------------------
{% endcomment %}

{% if section.blocks.size > 0 %}
  <style>
    /* Section Specific Layout Styles */
    #shopify-section-{{ section.id }} {
      overflow: hidden;
    }

    .ann-container {
      display: flex;
      justify-content: var(--ann-align, center);
      align-items: center;
      position: relative;
      padding-bottom: 2px;
      padding-top: 2px;
      min-height: 30px;
      width: 100%;
    }

    /* Desktop/Grid View */
    @media screen and (min-width: {{ section.settings.breakpoint | plus: 1 }}px) {
      .ann-container {
        display: flex;
        gap: 20px;
      }
      .ann-item {
        position: relative !important;
        opacity: 1 !important;
        visibility: visible !important;
        display: flex;
        justify-content: var(--ann-align, center);
      }
    }

    /* Mobile/Slider View */
    @media screen and (max-width: {{ section.settings.breakpoint }}px) {
      .ann-item {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: var(--ann-align, center);
        width: 100%;
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.5s ease-in-out;
        padding: 0 20px;
      }
      .ann-item.is-active {
        opacity: 1;
        visibility: visible;
      }
    }

    .ann-content {
      line-height: calc({{ section.settings.text_size }}px + 4px);
      font-size: {{ section.settings.text_size }}px;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      font-weight: 500;
      color: inherit;
    }

    .ann-icon {
      margin-right: 8px;
      display: flex;
      align-items: center;
      color: currentColor;
    }
    
    .ann-icon span {
      width: calc({{ section.settings.text_size }}px + 4px);
      height: calc({{ section.settings.text_size }}px + 4px);
      fill: currentColor;
    }
  </style>

  {%- capture alignment_style -%}
    {%- if section.settings.alignment == 'left' -%}flex-start
    {%- elsif section.settings.alignment == 'right' -%}flex-end
    {%- else -%}center
    {%- endif -%}
  {%- endcapture -%}

  <div class="{{ section.settings.header_background_color }} {{ section.settings.header_text_color }}" style="--ann-align: {{ alignment_style }};">
    <div class="page-wrapper">
      <div class="ann-container" id="AnnFade-{{ section.id }}">
        {% for block in section.blocks %}
          <div class="ann-item {% if forloop.first %}is-active{% endif %}" {{ block.shopify_attributes }}>
            {% if block.settings.link != blank %}
              <a href="{{ block.settings.link }}" class="ann-content">
            {% else %}
              <div class="ann-content">
            {% endif %}

              {% if block.settings.icon != 'none' %}
                {% render 'icon', icon: block.settings.icon, class: "ann-icon" size: section.settings.text_size %}
              {% endif %}

              {% if block.settings.text != blank %}
                <span>{{ block.settings.text }}</span>
              {% endif %}
    
            {% if block.settings.link != blank %}
              </a>
            {% else %}
              </div>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>
  </div>

  <script>
    (function() {
      const initFade = () => {
        const container = document.querySelector('#AnnFade-{{ section.id }}');
        if (!container) return;
        const items = container.querySelectorAll('.ann-item');
        const limit = {{ section.settings.breakpoint }};
        let index = 0;
        let timer = null;

        const run = () => {
          if (window.innerWidth <= limit) {
            items[index].classList.remove('is-active');
            index = (index + 1) % items.length;
            items[index].classList.add('is-active');
          }
        };

        if (timer) clearInterval(timer);
        timer = setInterval(run, {{ section.settings.autoplay_speed }});

        window.addEventListener('resize', () => {
          if (window.innerWidth > limit) {
            items.forEach(i => i.classList.remove('is-active'));
          } else {
            items[0].classList.add('is-active');
          }
        });
      };

      document.addEventListener('DOMContentLoaded', initFade);
      if (window.Shopify && Shopify.designMode) {
        document.addEventListener('shopify:section:load', initFade);
      }
    })();
  </script>
{% endif %}

