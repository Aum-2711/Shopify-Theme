<header>
    <div class="header-container">
        <div class="logo" style="text-align: {{ section.settings.logo_position | split: '-' | last }};">
            {% if settings.logo %}
                <a href="{{ shop.url }}">
                    <img
                    src="{{ settings.logo | img_url: settings.logo_max_width | append: 'px' }}" 
                    width="{{ settings.logo_max_width | append: 'px' }}" 
                    alt="{{ shop.name }}"
                    >
                </a>
            {% else %}
                <h1><a href="{{ shop.url }}">{{ shop.name }}</a></h1>
            {% endif %}
        </div>
        <nav class="main-menu" data-menu-type="{{ section.settings.menu_type_desktop }}">
            {% if section.settings.menu %}
                {% assign main_menu = linklists[section.settings.menu] %}
                <ul>
                    {% for link in main_menu.links %}
                        <li>
                            <a href="{{ link.url }}">{{ link.title }}</a>
                            {% if link.links.size > 0 and section.settings.menu_type_desktop != 'drawer' %}
                                <ul class="sub-menu">
                                    {% for sublink in link.links %}
                                        <li><a href="{{ sublink.url }}">{{ sublink.title }}</a></li>
                                    {% endfor %}
                                </ul>
                            {% endif %}
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </nav>
</header>

{% schema %}
{
  "name": "Header",
  "class": "section-header",
  "max_blocks": 3,
  "settings": [
    
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ]
}
{% endschema %}
