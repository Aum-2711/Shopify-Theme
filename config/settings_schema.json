  // Typography
  {
    "name": "Typography",
    "settings": [
      {
        "type": "header",
        "content": "Heading Typography"
      },
      {
        "type": "checkbox",
        "id": "use_custom_heading_font",
        "label": "Use custom heading font?",
        "default": false
      },
      {
        "type": "font_picker",
        "id": "heading_font",
        "label": "Heading Font (Shopify)",
        "default": "helvetica_n4"
      },
      {
        "type": "textarea",
        "id": "custom_heading_font_cdn",
        "label": "Custom Heading Font CDN Embed Code",
        "info": "Paste the <link> tags from Google Fonts or another CDN here."
      },
      {
        "type": "text",
        "id": "custom_heading_font_family",
        "label": "Custom Heading Font Family (CSS syntax)",
        "info": "Example: \"Barlow Semi Condensed\", sans-serif"
      },

      {
        "type": "range",
        "id": "page_title_font_size",
        "label": "Page Title Font Size",
        "min": 16,
        "max": 80,
        "step": 1,
        "default": 36,
        "unit": "px"
      },
      {
        "type": "select",
        "id": "page_title_font_weight",
        "label": "Page Title Font Weight",
        "default": "700",
        "options": [
          { "value": "400", "label": "Normal" },
          { "value": "500", "label": "Medium" },
          { "value": "600", "label": "Semi-bold" },
          { "value": "700", "label": "Bold" }
        ]
      },
      {
        "type": "range",
        "id": "section_title_font_size",
        "label": "Section Title Font Size",
        "min": 14,
        "max": 60,
        "step": 1,
        "default": 28,
        "unit": "px"
      },
      {
        "type": "select",
        "id": "section_title_font_weight",
        "label": "Section Title Font Weight",
        "default": "600",
        "options": [
          { "value": "400", "label": "Normal" },
          { "value": "500", "label": "Medium" },
          { "value": "600", "label": "Semi-bold" },
          { "value": "700", "label": "Bold" }
        ]
      },

      {
        "type": "header",
        "content": "Body Typography"
      },
      {
        "type": "checkbox",
        "id": "use_custom_body_font",
        "label": "Use custom body font?",
        "default": false
      },
      {
        "type": "font_picker",
        "id": "body_font",
        "label": "Body Font (Shopify)",
        "default": "helvetica_n4"
      },
      {
        "type": "textarea",
        "id": "custom_body_font_cdn",
        "label": "Custom Body Font CDN Embed Code",
        "info": "Paste the <link> tags from Google Fonts or another CDN here."
      },
      {
        "type": "text",
        "id": "custom_body_font_family",
        "label": "Custom Body Font Family (CSS syntax)",
        "info": "Example: \"Open Sans\", sans-serif"
      },

      {
        "type": "range",
        "id": "body_font_size",
        "label": "Body Text Font Size",
        "min": 12,
        "max": 32,
        "step": 1,
        "default": 16,
        "unit": "px"
      },
      {
        "type": "select",
        "id": "body_font_weight",
        "label": "Body Text Font Weight",
        "default": "400",
        "options": [
          { "value": "300", "label": "Light" },
          { "value": "400", "label": "Normal" },
          { "value": "500", "label": "Medium" },
          { "value": "600", "label": "Semi-bold" },
          { "value": "700", "label": "Bold" }
        ]
      },
      {
        "type": "range",
        "id": "link_font_size",
        "label": "Anchor (Link) Font Size",
        "min": 12,
        "max": 32,
        "step": 1,
        "default": 16,
        "unit": "px"
      },
      {
        "type": "select",
        "id": "link_font_weight",
        "label": "Anchor (Link) Font Weight",
        "default": "500",
        "options": [
          { "value": "400", "label": "Normal" },
          { "value": "500", "label": "Medium" },
          { "value": "600", "label": "Semi-bold" },
          { "value": "700", "label": "Bold" }
        ]
      }
    ]
  },
  // Layout settings
  {
    "name": "Layout",
    "settings": [
      {
        "type": "number",
        "id": "page_width",
        "label": "Page Width (px)",
        "default": 1200
      },
      {
        "type": "checkbox",
        "id": "page_full_width",
        "label": "Enable Full Width Layout",
        "default": false
      },
      {
        "type": "range",
        "id": "page_padding_x",
        "label": "Page Horizontal Padding (Left & Right)",
        "min": 0,
        "max": 100,
        "step": 2,
        "default": 20,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "section_spacing",
        "label": "Space Between Sections",
        "min": 0,
        "max": 200,
        "step": 5,
        "default": 60,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "column_gap",
        "label": "Gap Between Columns",
        "min": 0,
        "max": 100,
        "step": 2,
        "default": 20,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "row_gap",
        "label": "Gap Between Rows",
        "min": 0,
        "max": 100,
        "step": 2,
        "default": 20,
        "unit": "px"
      }
    ]
  },
  // Swatches settings
  {
    "name": "Swatches",
    "settings": [
      {
        "type": "select",
        "id": "swatch_display_type",
