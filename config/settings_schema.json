          { "value": "text", "label": "Text Swatches" },
          { "value": "dropdown", "label": "Dropdown" }
        ],
        "default": "text"
      },
      {
       "type": "select",
        "id": "image_swatch_display_type",
        "label": "Image Swatch Display Type",
        "options": [
          { "value": "dropdown", "label": "Dropdown" },
          { "value": "color", "label": "Color Swatches" },
          { "value": "image", "label": "Image Swatches" }
        ],
        "default": "color"
      }
    ]
  },
